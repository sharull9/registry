{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "config",
      "type": "registry:item",
      "category": "config",
      "tags": ["bundle", "config"],
      "registryDependencies": [
        "sharull9/registry/config-prettier",
        "sharull9/registry/config-eslint"
      ]
    },
    {
      "name": "config-prettier",
      "type": "registry:item",
      "category": "config",
      "tags": ["prettier", "formatting", "config"],
      "files": [
        {
          "path": ".prettierrc",
          "type": "registry:file",
          "target": "~/.prettierrc",
          "devDependencies": ["prettier", "prettier-plugin-tailwindcss"]
        },
        {
          "path": ".prettierignore",
          "type": "registry:file",
          "target": "~/.prettierignore"
        }
      ]
    },
    {
      "name": "config-eslint",
      "type": "registry:item",
      "category": "config",
      "tags": ["eslint", "linting", "config"],
      "files": [
        {
          "path": "eslint.config.mjs",
          "type": "registry:file",
          "target": "./eslint.config.mjs"
        }
      ]
    }
  ]
}
