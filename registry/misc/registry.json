{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "util",
      "type": "registry:item",
      "category": "misc",
      "tags": ["utils", "helpers", "tailwind"],
      "files": [
        {
          "path": "../../src/lib/utils.ts",
          "type": "registry:file",
          "target": "~/src/lib/utils.ts",
          "dependencies": ["clsx", "tailwind-merge"]
        }
      ]
    },
    {
      "name": "module-auth-example",
      "type": "registry:item",
