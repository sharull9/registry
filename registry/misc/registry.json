            "sharull9/registry/form",
            "sharull9/registry/util",
            "input",
            "button",
            "spinner"
          ],
          "dependencies": ["@hookform/resolvers", "react-hook-form", "zod"]
        },
        {
          "path": "../../src/modules/auth/ui/views/verify-otp-view.tsx",
          "type": "registry:file",
